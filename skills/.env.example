# QMT Trading Skill (next) — 客户端连接配置（兼容模板）
#
# 【推荐】Skills 会自动发现统一配置 qmt-bridge-next/config/config.ini
# （host/port/api_key/account_id 三端共用），通常无需本文件。
#
# 本文件仅在以下情况使用：
#   - config.ini 不在默认位置（此时应设 QMT_CONFIG 指向它，而非本文件）
#   - 临时覆盖连接参数（也可用命令行 --host/--port/--api-key）
#
# 复制为与 _shared 同级的 .env 后生效：
#   copy .env.example .env

# 客户端目标（不要写成 0.0.0.0）。qmt-bridge-next 默认端口 8000。
QMT_BRIDGE_HOST=127.0.0.1
QMT_BRIDGE_PORT=8000

# 须与统一配置 config.ini 的 api_key 一致（勿提交真实密钥）
# QMT_BRIDGE_API_KEY=your-secret-api-key

# QMT_BRIDGE_STOCK_ACCOUNT_ID=
# QMT_BRIDGE_CREDIT_ACCOUNT_ID=
# QMT_BRIDGE_DEFAULT_ACCOUNT=stock
